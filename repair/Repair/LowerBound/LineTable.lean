/-- **The line table** (`results/struct-lb-extend.md` §3.2 and Theorem B case 2, organize-archive
b5cb45e). Every admissible direction `(c, a)` with `c² + a² ≤ 900` is good with `L = 696`. -/
theorem lineGood_of_le_900 {c a : ℤ} (hadm : admB c a = true) (hH : c ^ 2 + a ^ 2 ≤ 900) :
    LineGood c a 696 := by
  have hc1 : 1 ≤ c := by
    simp only [admB, Bool.and_eq_true, decide_eq_true_eq] at hadm
    exact hadm.1.1.1.1.1.1.1.1
  have ha0 : a ≠ 0 := by
    simp only [admB, Bool.and_eq_true, decide_eq_true_eq] at hadm
    exact hadm.1.1.1.1.1.1.1.2
  have ha1 : 1 ≤ a ^ 2 := by
    have := pow_pos (abs_pos.mpr ha0) 2
    rw [sq_abs] at this
    omega
  have hc : c ≤ 29 := by nlinarith
  have ha : |a| ≤ ((30 : ℕ) : ℤ) := by
    rw [abs_le]
    push_cast
    constructor <;> nlinarith
  obtain ⟨c', rfl⟩ := Int.eq_ofNat_of_zero_le (by omega : 0 ≤ c)
  exact rowOK_spec ctxT8_ok (lineRow_ok c' (by omega) (by omega)) hadm hH ha

