/-- **The short lines below `n = 1177`** (`results/struct-lb-extend.md` §3.3, Theorem B,
organize-archive b5cb45e). Let `n` be a prime with `11 ≤ n < 1177` and `n ≠ 13`. Every admissible
direction `(c, a)` with `3 (c² + a²)² ≤ 4 n²` whose slope `a/c` is a tail label mod `n` is good at
`n`. -/
theorem lineGoodAt_of_lt_1177 {n : ℕ} (hp : n.Prime) (h11 : 11 ≤ n) (h13 : n ≠ 13)
    (h1177 : n < 1177) {c a : ℤ} (hadm : admB c a = true)
    (hH : 3 * (c ^ 2 + a ^ 2) ^ 2 ≤ 4 * (n : ℤ) ^ 2) (hlab : labelB c a n = true) :
    LineGoodAt c a n := by
  have hc1 : 1 ≤ c := by
    simp only [admB, Bool.and_eq_true, decide_eq_true_eq] at hadm
    exact hadm.1.1.1.1.1.1.1.1
  have hn2 : (n : ℤ) ^ 2 ≤ 1176 ^ 2 := pow_le_pow_left₀ (by positivity) (by omega) 2
  have hH' : c ^ 2 + a ^ 2 ≤ 1358 := by nlinarith [sq_nonneg (c ^ 2 + a ^ 2 - 1358)]
  have hc : c ≤ 36 := by nlinarith
  have ha : |a| ≤ 36 := by
    rw [abs_le]
    constructor <;> nlinarith
  have ha' : |a| ≤ ((49 : ℕ) : ℤ) := by
    push_cast
    linarith
  obtain ⟨c', rfl⟩ := Int.eq_ofNat_of_zero_le (by omega : 0 ≤ c)
  have hold := lineOK_of_rowOK (lineRowB_ok c' (by omega) (by omega)) hadm (by linarith) ha'
  have hs := smallOK_of_rowOK (smallRow_ok c' (by omega) (by omega)) hadm hH' ha
  exact lineGoodAt_of_smallOK ctxT8s_ok hs hold hp h11 h13 hH hlab

