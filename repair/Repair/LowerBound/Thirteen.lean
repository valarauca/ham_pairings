import Repair.LowerBound.Chart
import Repair.LowerBound.TailAgree

/-!
# `N_7 ≥ 2` through a second tail

Source: `results/struct-lb-extend.md` §3.3, Theorem B, the case `m = 7`, and
`results/struct-lb-factcheck-contra.md` claim 4 and §3 (organize-archive b5cb45e). At `n = 13`
the factor tail has `ρ = 1`. Exactly 30 of the 105 tails of `V_7 ∖ G0` have `ρ ≥ 2`, and this file
uses `T7 = {∞0, 78, 9 12, 10 11}`. Generated by `scripts/struct-lb-lean-lb3.py` in
organize-archive (not committed yet).

With every point of `ℤ/n` special, the walk of `ham_of_positions` needs no structure of `P`. A
unit `μ` with `2 μ w = 1` puts `y` at the position `2 y μ`, read in the order `i ↦ i w`.

* `ham_of_allPoints` : the walk through all of `ℤ/n`, with `s0 = 0`.
* `search13` : a kernel check over every `P` within distance `1` of `T7`, through its map `P̃`.
* `not_repairBound_one_seven` : `N_7 ≥ 2`, as `¬ RepairBound 7 G0 1`.
-/

namespace Pairing

namespace LowerBound

open PerfectMatching RoundRobin

/-- **The walk through every point** (`results/struct-lb-extend.md` §1, COD-186 Lemmas 1 and 2,
organize-archive b5cb45e). Let `2 μ w = 1` in `ℤ/n`. If the arc map of `P̃` in the order
`i ↦ s0 + i w` covers, then some `P ∪ F_t` is one cycle. -/
theorem ham_of_allPoints {N : ℕ} (hn : Odd (N + 1)) {s0 : ZMod (N + 1)}
    (P : PerfectMatching (Option (ZMod (N + 1)))) {μ w : ZMod (N + 1)} (hw : 2 * μ * w = 1)
    (hcov : ArcCovers (fun i : Fin (N + 1) ↦ s0 + ((i : ℕ) : ZMod (N + 1)) * w)
      (fun y ↦ (2 * (y - s0) * μ : ZMod (N + 1))) (fun y ↦ 2 * s0 - y) (pinned P)) :
    ∃ t, Ham P (factor hn t) := by
  have hμ : IsUnit μ := IsUnit.of_mul_eq_one (2 * w) (by linear_combination hw)
  have hval : ∀ i : Fin (N + 1), ((2 * (s0 + ((i : ℕ) : ZMod (N + 1)) * w - s0) * μ :
      ZMod (N + 1)).val : ℤ) = (i : ℕ) := by
    intro i
    have h : (2 * (s0 + ((i : ℕ) : ZMod (N + 1)) * w - s0) * μ : ZMod (N + 1)) =
        ((i : ℕ) : ZMod (N + 1)) := by
      linear_combination ((i : ℕ) : ZMod (N + 1)) * hw
    rw [h, ZMod.val_natCast_of_lt i.isLt]
  refine ham_of_positions hn id (fun y ↦ 2 * s0 - y) (fun _ ↦ rfl)
    (fun y hy ↦ absurd rfl (hy y)) (pinned P) (fun _ ↦ rfl)
    (fun i : Fin (N + 1) ↦ s0 + ((i : ℕ) : ZMod (N + 1)) * w)
    (fun y ↦ (2 * (y - s0) * μ : ZMod (N + 1))) ?_ hμ
    (fun y ↦ ((2 * (y - s0) * μ : ZMod (N + 1)).val : ℤ)) ?_ ?_ ?_ hcov
  · intro y
    change s0 + ((ZMod.val (2 * (y - s0) * μ) : ℕ) : ZMod (N + 1)) * w = y
    rw [ZMod.natCast_zmod_val]
    linear_combination (y - s0) * hw
  · intro y
    simp
  · intro i j hij
    simp only [hval]
    exact_mod_cast hij
  · rw [hval (Fin.last N), hval 0]
    simp

end LowerBound

namespace RoundRobin.Canonical

open PerfectMatching LowerBound

/-- The partners in `Q7 = T7 ∪ {16, 25, 34}`, read at `y = 0, …, 12`; `none` is `∞`. -/
def q7List : List (Option (ZMod 13)) :=
  [none, some 6, some 5, some 4, some 3, some 2, some 1, some 8, some 7, some 12, some 11,
    some 10, some 9]

/-- The mate map of `Q7`. -/
def q7Fn : Option (ZMod 13) → Option (ZMod 13)
  | none => some 0
  | some y => q7List.getD y.val none

/-- `Q7` is an involution. -/
theorem q7Fn_involutive : Function.Involutive q7Fn := by
  intro v
  revert v
  decide

/-- The perfect matching `Q7 = T7 ∪ {16, 25, 34}` of `V_7`. -/
def q7 : PerfectMatching (Vertex 7) where
  mate := q7Fn_involutive.toPerm
  mate_mate := q7Fn_involutive
  mate_ne := by decide

/-- `Q7` maps the tail vertices to tail vertices. -/
theorem q7_mem_compl : ∀ v ∈ (FactorCap.gadget 7)ᶜ, q7.mate v ∈ (FactorCap.gadget 7)ᶜ := by
  intro v hv
  rw [Finset.mem_compl] at hv ⊢
  revert hv
  revert v
  decide +kernel

/-- The second tail `T7 = {∞0, 78, 9 12, 10 11}` at `m = 7` (`results/struct-lb-extend.md` §3.3,
organize-archive b5cb45e). -/
def tail7 : PerfectMatching ((FactorCap.gadget 7)ᶜ : Finset (Vertex 7)) :=
  restrict q7 _ q7_mem_compl

/-- The eight tail vertices of `V_7`. -/
def tailList : List (Option (ZMod 13)) :=
  [none, some 0, some 7, some 8, some 9, some 10, some 11, some 12]

/-- Every vertex off `G0` is a tail vertex. -/
theorem mem_tailList : ∀ u : Vertex 7, u ∉ FactorCap.gadget 7 → u ∈ tailList := by
  decide

/-- `y` is an end of the edge `{u, Q7 u}`. -/
def freeB (u : Option (ZMod 13)) (y : ZMod 13) : Bool :=
  decide (u = some y) || decide (q7Fn u = some y)

/-- The map `Q̃7`: the partner of `y`, or `y` itself for the partner `0` of `∞`. -/
def qt (y : ZMod 13) : ZMod 13 :=
  (q7Fn (some y)).getD y

/-- The units `μ` of `ℤ/13`, each with `w = (2 μ)⁻¹`. -/
def muList : List (ZMod 13 × ZMod 13) :=
  [(1, 7), (2, 10), (3, 11), (4, 5), (5, 4), (6, 12), (7, 1), (8, 9), (9, 8), (10, 2), (11, 3),
    (12, 6)]

/-- `2 μ w = 1` for every pair of `muList`. -/
theorem muList_ok : ∀ x ∈ muList, 2 * x.1 * x.2 = 1 := by
  decide +kernel

/-- The order `i ↦ i w` of `ℤ/13`. -/
def ord13 (w : ZMod 13) : Fin 13 → ZMod 13 :=
  fun i ↦ 0 + ((i : ℕ) : ZMod 13) * w

/-- The position `2 y μ` of `y`. -/
def ordInv13 (μ : ZMod 13) : ZMod 13 → Fin 13 :=
  fun y ↦ (2 * (y - 0) * μ : ZMod 13)

/-- `F_0` on `ℤ/13`, `y ↦ -y`. -/
def tau13 : ZMod 13 → ZMod 13 :=
  fun y ↦ 2 * 0 - y

/-- A list of thirteen values read as a map of `ℤ/13`. -/
def rOf (l : List (ZMod 13)) : ZMod 13 → ZMod 13 :=
  fun y ↦ l.getD y.val 0

set_option synthInstance.maxSize 1000000 in
set_option maxRecDepth 100000 in
/-- **The kernel check at `n = 13`** (`results/struct-lb-extend.md` §3.3, organize-archive
b5cb45e). The hypotheses enumerate the involutions `a` of `ℤ/13` with at most one fixed point that
agree with `Q̃7` at the tail points off one edge `{u, Q7 u}`. Each has a unit `μ` whose walk
covers. -/
theorem search13 : ∀ u ∈ tailList,
    ∀ a0 : ZMod 13,
    (freeB u 0 = false → a0 = qt 0) →
    ∀ a7 : ZMod 13,
    (freeB u 7 = false → a7 = qt 7) → (a0 = 7 ↔ a7 = 0) → (a0 = 0 → a7 ≠ 7) →
    ∀ a8 : ZMod 13,
    (freeB u 8 = false → a8 = qt 8) → (a0 = 8 ↔ a8 = 0) → (a7 = 8 ↔ a8 = 7) → (a0 = 0 → a8 ≠ 8) →
    ∀ a9 : ZMod 13,
    (freeB u 9 = false → a9 = qt 9) → (a0 = 9 ↔ a9 = 0) → (a7 = 9 ↔ a9 = 7) → (a8 = 9 ↔ a9 = 8) →
    (a0 = 0 → a9 ≠ 9) →
    ∀ a10 : ZMod 13,
    (freeB u 10 = false → a10 = qt 10) → (a0 = 10 ↔ a10 = 0) → (a7 = 10 ↔ a10 = 7) →
    (a8 = 10 ↔ a10 = 8) → (a9 = 10 ↔ a10 = 9) → (a0 = 0 → a10 ≠ 10) →
    ∀ a11 : ZMod 13,
    (freeB u 11 = false → a11 = qt 11) → (a0 = 11 ↔ a11 = 0) → (a7 = 11 ↔ a11 = 7) →
    (a8 = 11 ↔ a11 = 8) → (a9 = 11 ↔ a11 = 9) → (a10 = 11 ↔ a11 = 10) → (a0 = 0 → a11 ≠ 11) →
    ∀ a12 : ZMod 13,
    (freeB u 12 = false → a12 = qt 12) → (a0 = 12 ↔ a12 = 0) → (a7 = 12 ↔ a12 = 7) →
    (a8 = 12 ↔ a12 = 8) → (a9 = 12 ↔ a12 = 9) → (a10 = 12 ↔ a12 = 10) → (a11 = 12 ↔ a12 = 11) →
    (a0 = 0 → a12 ≠ 12) →
    ∀ a1 : ZMod 13,
    (a0 = 1 ↔ a1 = 0) → (a7 = 1 ↔ a1 = 7) → (a8 = 1 ↔ a1 = 8) → (a9 = 1 ↔ a1 = 9) →
    (a10 = 1 ↔ a1 = 10) → (a11 = 1 ↔ a1 = 11) → (a12 = 1 ↔ a1 = 12) → (a0 = 0 → a1 ≠ 1) →
    ∀ a2 : ZMod 13,
    (a0 = 2 ↔ a2 = 0) → (a7 = 2 ↔ a2 = 7) → (a8 = 2 ↔ a2 = 8) → (a9 = 2 ↔ a2 = 9) →
    (a10 = 2 ↔ a2 = 10) → (a11 = 2 ↔ a2 = 11) → (a12 = 2 ↔ a2 = 12) → (a1 = 2 ↔ a2 = 1) →
    (a0 = 0 → a2 ≠ 2) → (a1 = 1 → a2 ≠ 2) →
    ∀ a3 : ZMod 13,
    (a0 = 3 ↔ a3 = 0) → (a7 = 3 ↔ a3 = 7) → (a8 = 3 ↔ a3 = 8) → (a9 = 3 ↔ a3 = 9) →
    (a10 = 3 ↔ a3 = 10) → (a11 = 3 ↔ a3 = 11) → (a12 = 3 ↔ a3 = 12) → (a1 = 3 ↔ a3 = 1) →
    (a2 = 3 ↔ a3 = 2) → (a0 = 0 → a3 ≠ 3) → (a1 = 1 → a3 ≠ 3) → (a2 = 2 → a3 ≠ 3) →
    ∀ a4 : ZMod 13,
    (a0 = 4 ↔ a4 = 0) → (a7 = 4 ↔ a4 = 7) → (a8 = 4 ↔ a4 = 8) → (a9 = 4 ↔ a4 = 9) →
    (a10 = 4 ↔ a4 = 10) → (a11 = 4 ↔ a4 = 11) → (a12 = 4 ↔ a4 = 12) → (a1 = 4 ↔ a4 = 1) →
    (a2 = 4 ↔ a4 = 2) → (a3 = 4 ↔ a4 = 3) → (a0 = 0 → a4 ≠ 4) → (a1 = 1 → a4 ≠ 4) →
    (a2 = 2 → a4 ≠ 4) → (a3 = 3 → a4 ≠ 4) →
    ∀ a5 : ZMod 13,
    (a0 = 5 ↔ a5 = 0) → (a7 = 5 ↔ a5 = 7) → (a8 = 5 ↔ a5 = 8) → (a9 = 5 ↔ a5 = 9) →
    (a10 = 5 ↔ a5 = 10) → (a11 = 5 ↔ a5 = 11) → (a12 = 5 ↔ a5 = 12) → (a1 = 5 ↔ a5 = 1) →
    (a2 = 5 ↔ a5 = 2) → (a3 = 5 ↔ a5 = 3) → (a4 = 5 ↔ a5 = 4) → (a0 = 0 → a5 ≠ 5) →
    (a1 = 1 → a5 ≠ 5) → (a2 = 2 → a5 ≠ 5) → (a3 = 3 → a5 ≠ 5) → (a4 = 4 → a5 ≠ 5) →
    ∀ a6 : ZMod 13,
    (a0 = 6 ↔ a6 = 0) → (a7 = 6 ↔ a6 = 7) → (a8 = 6 ↔ a6 = 8) → (a9 = 6 ↔ a6 = 9) →
    (a10 = 6 ↔ a6 = 10) → (a11 = 6 ↔ a6 = 11) → (a12 = 6 ↔ a6 = 12) → (a1 = 6 ↔ a6 = 1) →
    (a2 = 6 ↔ a6 = 2) → (a3 = 6 ↔ a6 = 3) → (a4 = 6 ↔ a6 = 4) → (a5 = 6 ↔ a6 = 5) →
    (a0 = 0 → a6 ≠ 6) → (a1 = 1 → a6 ≠ 6) → (a2 = 2 → a6 ≠ 6) → (a3 = 3 → a6 ≠ 6) →
    (a4 = 4 → a6 ≠ 6) → (a5 = 5 → a6 ≠ 6) →
    ∃ x ∈ muList, coversB (ord13 x.2) (ordInv13 x.1) tau13
      (rOf [a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12]) = true := by
  decide +kernel

/-- **`ρ(T7) ≥ 2`** (`results/struct-lb-extend.md` §3.3, organize-archive b5cb45e). Every zero
state differs from the second tail `T7` in at least two edges. -/
theorem two_le_tailDist_tail7 (P : ZeroState 7) : 2 ≤ tailDist P.1 tail7 := by
  by_contra h0
  obtain ⟨u, hu, hagree⟩ := exists_agree_of_tailDist_le_one (T := tail7) (Q := q7)
    (fun _ ↦ rfl) (by omega : tailDist P.1 tail7 ≤ 1)
  set p : ZMod 13 → ZMod 13 := fun y ↦ pinned P.1 y with hpdef
  have hpp : ∀ y, p (p y) = y := fun y ↦ pinnedFn_involutive P.1 y
  have hinv : ∀ y z, p y = z ↔ p z = y :=
    fun y z ↦ ⟨fun h ↦ by rw [← h, hpp], fun h ↦ by rw [← h, hpp]⟩
  have hfix0 : ∀ y, p y = y → P.1.mate none = some y := by
    intro y hy
    rcases h : P.1.mate (some y) with _ | w
    · rw [← h, mate_mate]
    · have h1 : p y = w := pinned_apply_of_mate_eq_some _ h
      rw [hy] at h1
      subst h1
      exact absurd h (P.1.mate_ne _)
  have hfix : ∀ y z, y ≠ z → p y = y → p z ≠ z :=
    fun y z hyz hy hz ↦ hyz (Option.some_inj.mp ((hfix0 y hy).symm.trans (hfix0 z hz)))
  have hag : ∀ y : ZMod 13, some y ∉ FactorCap.gadget 7 → freeB u y = false → p y = qt y := by
    intro y hy hf
    simp only [freeB, Bool.or_eq_false_iff, decide_eq_false_iff_not] at hf
    have h1 := hagree (some y) hy (fun h ↦ hf.1 h.symm) (fun h ↦ hf.2 h.symm)
    change (P.1.mate (some y)).getD y = (q7Fn (some y)).getD y
    rw [h1]
    rfl
  obtain ⟨x, hx, hcov⟩ := search13 u (mem_tailList u hu)
    (p 0) (hag 0 (by decide)) (p 7) (hag 7 (by decide)) (hinv 0 7) (hfix 0 7 (by decide)) (p 8)
      (hag 8 (by decide)) (hinv 0 8) (hinv 7 8) (hfix 0 8 (by decide)) (p 9) (hag 9 (by decide))
      (hinv 0 9) (hinv 7 9) (hinv 8 9) (hfix 0 9 (by decide)) (p 10) (hag 10 (by decide))
      (hinv 0 10) (hinv 7 10) (hinv 8 10) (hinv 9 10) (hfix 0 10 (by decide)) (p 11)
      (hag 11 (by decide)) (hinv 0 11) (hinv 7 11) (hinv 8 11) (hinv 9 11) (hinv 10 11)
      (hfix 0 11 (by decide)) (p 12) (hag 12 (by decide)) (hinv 0 12) (hinv 7 12) (hinv 8 12)
      (hinv 9 12) (hinv 10 12) (hinv 11 12) (hfix 0 12 (by decide)) (p 1) (hinv 0 1) (hinv 7 1)
      (hinv 8 1) (hinv 9 1) (hinv 10 1) (hinv 11 1) (hinv 12 1) (hfix 0 1 (by decide)) (p 2)
      (hinv 0 2) (hinv 7 2) (hinv 8 2) (hinv 9 2) (hinv 10 2) (hinv 11 2) (hinv 12 2) (hinv 1 2)
      (hfix 0 2 (by decide)) (hfix 1 2 (by decide)) (p 3) (hinv 0 3) (hinv 7 3) (hinv 8 3)
      (hinv 9 3) (hinv 10 3) (hinv 11 3) (hinv 12 3) (hinv 1 3) (hinv 2 3) (hfix 0 3 (by decide))
      (hfix 1 3 (by decide)) (hfix 2 3 (by decide)) (p 4) (hinv 0 4) (hinv 7 4) (hinv 8 4)
      (hinv 9 4) (hinv 10 4) (hinv 11 4) (hinv 12 4) (hinv 1 4) (hinv 2 4) (hinv 3 4)
      (hfix 0 4 (by decide)) (hfix 1 4 (by decide)) (hfix 2 4 (by decide)) (hfix 3 4 (by decide))
      (p 5) (hinv 0 5) (hinv 7 5) (hinv 8 5) (hinv 9 5) (hinv 10 5) (hinv 11 5) (hinv 12 5)
      (hinv 1 5) (hinv 2 5) (hinv 3 5) (hinv 4 5) (hfix 0 5 (by decide)) (hfix 1 5 (by decide))
      (hfix 2 5 (by decide)) (hfix 3 5 (by decide)) (hfix 4 5 (by decide)) (p 6) (hinv 0 6)
      (hinv 7 6) (hinv 8 6) (hinv 9 6) (hinv 10 6) (hinv 11 6) (hinv 12 6) (hinv 1 6) (hinv 2 6)
      (hinv 3 6) (hinv 4 6) (hinv 5 6) (hfix 0 6 (by decide)) (hfix 1 6 (by decide))
      (hfix 2 6 (by decide)) (hfix 3 6 (by decide)) (hfix 4 6 (by decide)) (hfix 5 6 (by decide))
  have hr : rOf [p 0, p 1, p 2, p 3, p 4, p 5, p 6, p 7, p 8, p 9, p 10, p 11, p 12] =
      ⇑(pinned P.1) := by
    funext y
    fin_cases y <;> rfl
  rw [hr] at hcov
  obtain ⟨t, ht⟩ := ham_of_allPoints (N := 12) (s0 := 0) (modulus_odd 7) P.1 (muList_ok x hx)
    (coversB_spec hcov)
  exact P.2 t ht

/-- **`N_7 ≥ 2`** (`results/struct-lb-extend.md` §3.3, Theorem B, the case `m = 7`,
organize-archive b5cb45e). No zero state lies within distance `1` of the second tail `T7`, so
`RepairBound 7 G0 1` fails. -/
theorem not_repairBound_one_seven : ¬RepairBound 7 (FactorCap.gadget 7) 1 := by
  intro h
  obtain ⟨P, hP⟩ := h tail7
  have := two_le_tailDist_tail7 P
  omega

end RoundRobin.Canonical

end Pairing
