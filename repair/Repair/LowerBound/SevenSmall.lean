/-- The points check and their masks cover all 105 matchings (`results/struct-lb-extend.md`
§3.3, Theorem B case 3, organize-archive b5cb45e). -/
theorem inf7T_ok : ∀ n ∈ [11, 17, 19, 23],
    ((inf7T n).all (pt7OK n) && orAll ((inf7T n).map Pt7.m) == 2 ^ 105 - 1) = true := by
  decide +kernel

/-- **Soundness of `pt7OK`** (`results/struct-lb-extend.md` §1, Lemma 0, organize-archive
b5cb45e). -/
theorem realCell7_of_pt7OK {e : Pt7} (hn : 0 < n) (h : pt7OK n e = true) :
    RealCell7 e.o e.k ((e.μ : ℝ) / n) := by
  simp only [pt7OK, Bool.and_eq_true] at h
  intro i hi
  have h1 := allBelow_spec h.2 i hi
  simp only [decide_eq_true_eq] at h1
  set f := gapForm7 e.o e.k i
  have hnR : (0 : ℝ) < n := by exact_mod_cast hn
  have h2 : (0 : ℝ) < ((f.1 * e.μ + f.2 * n : ℤ) : ℝ) := by exact_mod_cast h1
  have h3 : evalF1 f ((e.μ : ℝ) / n) = ((f.1 * e.μ + f.2 * n : ℤ) : ℝ) / n := by
    simp only [evalF1]
    push_cast
    field_simp
  rw [h3]
  exact div_pos h2 hnR

/-- **The cells of `(1, 3, 5, ∞)` at `n = 11, 17, 19, 23`** (`results/struct-lb-extend.md`
§3.3, Theorem B cases 1 and 3, organize-archive b5cb45e). Every involution `r` of `Fin 7` with at
most one fixed point is covered by the context of a cell that holds a point `μ/n`. -/
theorem exists_cell7_small (hn : n ∈ [11, 17, 19, 23]) {r : Fin 7 → Fin 7}
    (h1 : ∀ j, r (r j) = j) (h2 : ∀ i j, r i = i → r j = j → i = j) :
    ∃ (o oi : List ℕ) (k : List ℤ) (μ : ℤ), (∀ j, fin7 o (fin7 oi j) = j) ∧
      ArcCovers (fin7 o) (fin7 oi) tau7 r ∧ RealCell7 o k ((μ : ℝ) / n) := by
  have hok := inf7T_ok n hn
  simp only [Bool.and_eq_true, beq_iff_eq] at hok
  obtain ⟨hall, hfull⟩ := hok
  have hn0 : 0 < n := by simp at hn; omega
  obtain ⟨i, hi, rfl⟩ := exists_index_rTable7 h1 h2
  have hb : (orAll ((inf7T n).map Pt7.m)).testBit i = true := by
    rw [hfull, Nat.testBit_two_pow_sub_one, decide_eq_true_eq]
    exact hi
  obtain ⟨m, hm, hb'⟩ := exists_mem_testBit_of_orAll hb
  obtain ⟨e, he, rfl⟩ := List.mem_map.mp hm
  have hpt := List.all_eq_true.mp hall e he
  have hmask := hpt
  simp only [pt7OK, maskOK7, Bool.and_eq_true] at hmask
  refine ⟨e.o, e.oi, e.k, e.μ, fun j ↦ ?_, ?_, realCell7_of_pt7OK hn0 hpt⟩
  · have := allBelow_spec hmask.1.1 j j.2
    simp only [beq_iff_eq] at this
    exact Fin.ext (by simpa [fin7, oN7] using this)
  · have := allBelow_spec hmask.1.2 i hi
    simp only [hb', Bool.not_true, Bool.false_or] at this
    exact coversB_spec this

