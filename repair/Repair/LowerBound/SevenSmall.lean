/-!
# The core `{e_∞}` at the primes `11, 17, 19, 23`

Source: `results/struct-lb-extend.md` §2 (the `k1` table for `(1, 3, 5, ∞)`) and §3.3,
Theorem B cases 1 and 3, with `results/struct-lb-contra.md` §3.1, Lemma 2a (organize-archive
b5cb45e). Generated by `scripts/struct-lb-lean-lb3.py` in organize-archive (not committed yet).

Below `n = 25` a cell of length `1/24` need not hold a point `μ/n`. At each of the four primes
`n = 11, 17, 19, 23` the table `inf7T n` names six or seven multipliers `μ`, each in a cell of
`(1, 3, 5, ∞)` whose context covers the matchings of its mask, and the masks cover all 105.

* `exists_cell7_small` : at these four primes, every involution of `Fin 7` with at most one fixed
  point is covered by the context of a cell that holds a point `μ/n`.
-/

namespace Pairing

namespace LowerBound

variable {n : ℕ}

/-- A point of the circle: the context `o`, its inverse `oi`, its cover mask `m`, the shifts `k`
and the multiplier `μ` of the point `μ/n`. -/
structure Pt7 where
  o : List ℕ
  oi : List ℕ
  m : ℕ
  k : List ℤ
  μ : ℤ

/-- The check of one point: a correct mask, and every gap form positive at `μ/n`. -/
def pt7OK (n : ℕ) (e : Pt7) : Bool :=
  maskOK7 e.o e.oi e.m &&
    allBelow (fun i ↦ decide (0 < (gapForm7 e.o e.k i).1 * e.μ + (gapForm7 e.o e.k i).2 * n)) 7

