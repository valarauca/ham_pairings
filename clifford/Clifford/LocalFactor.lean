import Clifford.Frame

/-!
# Local factor at a gap (sketch §6)

The sketch's `A_κ ≅ M₂(𝔽₂)` in concrete form. At gap `k`, `∂ = lower k = E_k + (k + 1) I`,
`F = F_k` and `R = F ∂ F` act on slot `k` of the basis `w_S` as the matrix units of `M₂(𝔽₂)`,
and they lie in the algebra generated by `E_k` and `F_k`.

* `lower_w'` : `∂ w_S = [k ∈ S] w_{S \ k}`.
* `raise_w` : `R w_S = [k ∉ S] w_{S ∪ k}`.
* `raise_lower_w`, `lower_raise_w` : `R∂` and `∂R` are the projections onto `k ∈ S` and `k ∉ S`.
* `lower_mem_adjoin`, `frameF_mem_adjoin`, `raise_mem_adjoin`.
-/

namespace Pairing.PerfectMatching

open Equiv

variable (n : ℕ)

/-- `R = F ∂ F`, the raising operator at gap `k`. -/
def raise (k : Fin (n - 1)) : Module.End F₂ (W (Fin (2 * n))) :=
  frameF n k * lower n k k.2 * frameF n k

theorem symmDiff_single_of_notMem {k : Fin (n - 1)} {S : Finset (Fin (n - 1))} (h : k ∉ S) :
    symmDiff {k} S = insert k S := by
  ext x
  by_cases hx : x = k
  · subst hx
    simp [h, Finset.mem_symmDiff]
  · simp [hx, Finset.mem_symmDiff]

theorem raise_w (k : Fin (n - 1)) (S : Finset (Fin (n - 1))) :
    raise n k (w n S) = if k ∈ S then 0 else w n (insert k S) := by
  rw [raise, Module.End.mul_apply, Module.End.mul_apply, frameF_w, lower_w']
  by_cases h : k ∈ S
  · rw [ite_eq_right (by simp [Finset.mem_symmDiff, h]), ite_eq_left h, map_zero]
  · rw [ite_eq_left (by simp [Finset.mem_symmDiff, h]), ite_eq_right h, frameF_w,
      symmDiff_single_erase_self n h, symmDiff_single_of_notMem n h]

theorem raise_lower_w (k : Fin (n - 1)) (S : Finset (Fin (n - 1))) :
    (raise n k * lower n k k.2) (w n S) = if k ∈ S then w n S else 0 := by
  rw [Module.End.mul_apply, lower_w']
  by_cases h : k ∈ S
  · rw [ite_eq_left h, ite_eq_left h, raise_w, ite_eq_right (Finset.notMem_erase k S),
      Finset.insert_erase h]
  · rw [ite_eq_right h, ite_eq_right h, map_zero]

theorem lower_raise_w (k : Fin (n - 1)) (S : Finset (Fin (n - 1))) :
    (lower n k k.2 * raise n k) (w n S) = if k ∈ S then 0 else w n S := by
  rw [Module.End.mul_apply, raise_w]
  by_cases h : k ∈ S
  · rw [ite_eq_left h, ite_eq_left h, map_zero]
  · rw [ite_eq_right h, ite_eq_right h, lower_w', ite_eq_left (Finset.mem_insert_self k S),
      Finset.erase_insert h]

/-- `∂ = E_k + (k + 1) I`. -/
theorem lower_eq (k : Fin (n - 1)) : lower n k k.2 = frameE n k + ((k + 1 : ℕ) : F₂) • 1 := by
  rw [frameE_eq, add_assoc, ← add_smul, CharTwo.add_self_eq_zero, zero_smul, add_zero]

/-- The local algebra `⟨E_k, F_k⟩`. -/
def localAlg (k : Fin (n - 1)) : Subalgebra F₂ (Module.End F₂ (W (Fin (2 * n)))) :=
  Algebra.adjoin F₂ {frameE n k, frameF n k}

theorem frameF_mem_adjoin (k : Fin (n - 1)) : frameF n k ∈ localAlg n k :=
  Algebra.subset_adjoin (by simp)

theorem lower_mem_adjoin (k : Fin (n - 1)) : lower n k k.2 ∈ localAlg n k := by
  rw [lower_eq]
  exact add_mem (Algebra.subset_adjoin (by simp)) (Subalgebra.smul_mem _ (one_mem _) _)

theorem raise_mem_adjoin (k : Fin (n - 1)) : raise n k ∈ localAlg n k :=
  mul_mem (mul_mem (frameF_mem_adjoin n k) (lower_mem_adjoin n k)) (frameF_mem_adjoin n k)

end Pairing.PerfectMatching
