import Clifford.LocalFactor

/-!
# Assembly (sketch §6)

* `eq_top_of_rankOne` says a subalgebra of `End(M)` is everything once it contains one rank-one
  map `b_{i₀} ⊗ b*_{i₁}`, with `A b_{i₀}` covering the basis and `b*_{i₁} ∘ A` covering the dual
  basis.
* `lowerProd_w` : the product `Λ` of all lowerings sends `w_univ` to `w_∅` and kills every
  other `w_S`, so `Λ` is rank one.
* `adjoin_frame_eq_top` : the frame `{E_k, F_k}` generates `End(W_n)`. This is the sketch's map
  `Φ : ⊗_k A_κ → End(W_n)` being onto, and the check `dim ⟨E, F⟩ = 4^(n-1) = (dim W_n)²`.
  It needs no separate input on the rank of `H`.
-/

namespace Pairing.PerfectMatching

open Equiv

/-- Rank-one criterion for a subalgebra of `End(M)` to be everything. -/
theorem eq_top_of_rankOne {K ι M : Type*} [Field K] [Finite ι] [AddCommGroup M]
    [Module K M] (b : Module.Basis ι K M) (A : Subalgebra K (Module.End K M)) (i0 i1 : ι)
    (hR : (b.coord i1).smulRight (b i0) ∈ A) (hcyc : ∀ i, ∃ a ∈ A, a (b i0) = b i)
    (hdual : ∀ j, ∃ a ∈ A, (b.coord i1).comp a = b.coord j) : A = ⊤ := by
  classical
  have := Fintype.ofFinite ι
  have hrank : ∀ i j, (b.coord j).smulRight (b i) ∈ A := by
    intro i j
    obtain ⟨a, ha, hai⟩ := hcyc i
    obtain ⟨c, hc, hcj⟩ := hdual j
    have e : (b.coord j).smulRight (b i) = a * (b.coord i1).smulRight (b i0) * c := by
      ext v
      rw [Module.End.mul_apply, Module.End.mul_apply, LinearMap.smulRight_apply,
        LinearMap.smulRight_apply, map_smul, hai, ← hcj, LinearMap.comp_apply]
    rw [e]
    exact A.mul_mem (A.mul_mem ha hR) hc
  rw [eq_top_iff]
  intro f _
  have hf : f = ∑ i, ∑ j, b.repr (f (b j)) i • (b.coord j).smulRight (b i) := by
    refine b.ext fun k ↦ ?_
    simp [Module.Basis.coord_apply, Finsupp.single_apply, Module.Basis.sum_repr]
  rw [hf]
  exact A.sum_mem fun i _ ↦ A.sum_mem fun j _ ↦ A.smul_mem (hrank i j) _

variable (n : ℕ)

/-- The product of the lowerings at the gaps `< m`. -/
def lowerProd : (m : ℕ) → m ≤ n - 1 → Module.End F₂ (W (Fin (2 * n)))
  | 0, _ => 1
  | m + 1, h => lower n m (by omega) * lowerProd m (by omega)

theorem lowerProd_w (m : ℕ) (hm : m ≤ n - 1) (S : Finset (Fin (n - 1))) :
    lowerProd n m hm (w n S) =
      if ∀ g : Fin (n - 1), (g : ℕ) < m → g ∈ S then w n (S.filter fun g ↦ m ≤ (g : ℕ))
      else 0 := by
  induction m with
  | zero =>
    simp [lowerProd]
  | succ m ih =>
    rw [lowerProd, Module.End.mul_apply, ih (by omega)]
    by_cases hall : ∀ g : Fin (n - 1), (g : ℕ) < m → g ∈ S
    · rw [ite_eq_left hall, lower_w]
      by_cases hm' : (⟨m, by omega⟩ : Fin (n - 1)) ∈ S
      · have hmem : (⟨m, by omega⟩ : Fin (n - 1)) ∈
            S.filter (fun g : Fin (n - 1) ↦ m ≤ (g : ℕ)) :=
          Finset.mem_filter.mpr ⟨hm', le_refl m⟩
        have hall' : ∀ g : Fin (n - 1), (g : ℕ) < m + 1 → g ∈ S := by
          intro g hg
          rcases Nat.lt_succ_iff_lt_or_eq.mp hg with h | h
          · exact hall g h
          · have e : g = ⟨m, by omega⟩ := Fin.ext h
            rw [e]
            exact hm'
        rw [ite_eq_left hmem, ite_eq_left hall']
        congr 1
        ext g
        simp only [Finset.mem_erase, Finset.mem_filter, ne_eq, Fin.ext_iff]
        constructor
        · rintro ⟨h1, h2, h3⟩
          exact ⟨h2, by omega⟩
        · rintro ⟨h2, h3⟩
          exact ⟨by omega, h2, by omega⟩
      · rw [ite_eq_right (fun h ↦ hm' (Finset.mem_filter.mp h).1),
          ite_eq_right (fun h ↦ hm' (h ⟨m, by omega⟩ (by simp)))]
    · rw [ite_eq_right hall, map_zero, ite_eq_right (fun h ↦ hall fun g hg ↦ h g (by omega))]

/-- `Λ`, the product of all lowerings. -/
def bigLower : Module.End F₂ (W (Fin (2 * n))) :=
  lowerProd n (n - 1) le_rfl

theorem bigLower_w (S : Finset (Fin (n - 1))) :
    bigLower n (w n S) = if S = Finset.univ then w n ∅ else 0 := by
  rw [bigLower, lowerProd_w]
  have hiff : (∀ g : Fin (n - 1), (g : ℕ) < n - 1 → g ∈ S) ↔ S = Finset.univ :=
    ⟨fun h ↦ Finset.eq_univ_of_forall fun g ↦ h g g.2, fun h g _ ↦ h ▸ Finset.mem_univ g⟩
  have hempty : (S.filter fun g : Fin (n - 1) ↦ n - 1 ≤ (g : ℕ)) = ∅ :=
    Finset.filter_eq_empty_iff.mpr fun g _ ↦ by have := g.2; omega
  rw [if_congr hiff rfl rfl, hempty]

/-- `Λ = w_∅ ⊗ w*_univ` is rank one. -/
theorem bigLower_eq (hn : 1 ≤ n) :
    bigLower n = ((wBasis n hn).coord Finset.univ).smulRight (w n ∅) := by
  refine (wBasis n hn).ext fun S ↦ ?_
  rw [wBasis_apply, bigLower_w, LinearMap.smulRight_apply, ← wBasis_apply n hn S,
    Module.Basis.coord_apply, Module.Basis.repr_self, Finsupp.single_apply]
  split_ifs <;> simp

/-- The algebra generated by the frame `{E_k, F_k}`. -/
def frameAlg : Subalgebra F₂ (Module.End F₂ (W (Fin (2 * n)))) :=
  Algebra.adjoin F₂ (Set.range (frameE n) ∪ Set.range (frameF n))

theorem localAlg_le (k : Fin (n - 1)) : localAlg n k ≤ frameAlg n := by
  apply Algebra.adjoin_mono
  rintro x (rfl | rfl)
  · exact Or.inl ⟨k, rfl⟩
  · exact Or.inr ⟨k, rfl⟩

theorem ρW_sigma_mem (S : Finset (Fin (n - 1))) : ρW (sigma n S) ∈ frameAlg n := by
  induction S using Finset.induction_on with
  | empty =>
    rw [sigma_empty, map_one]
    exact one_mem _
  | insert g S hg ih =>
    rw [← symmDiff_single_of_notMem n hg, ← sigma_mul, map_mul]
    exact mul_mem (localAlg_le n g (frameF_mem_adjoin n g)) ih

theorem lowerProd_mem (m : ℕ) (hm : m ≤ n - 1) : lowerProd n m hm ∈ frameAlg n := by
  induction m with
  | zero => exact one_mem _
  | succ m ih =>
    exact mul_mem (localAlg_le n ⟨m, by omega⟩ (lower_mem_adjoin n ⟨m, by omega⟩)) (ih (by omega))

theorem symmDiff_univ_symmDiff_eq_univ (S T : Finset (Fin (n - 1))) :
    symmDiff (symmDiff T Finset.univ) S = Finset.univ ↔ S = T := by
  rw [symmDiff_right_comm, symmDiff_eq_right, symmDiff_eq_bot, eq_comm]

/-- The frame generates `End(W_n)`. -/
theorem adjoin_frame_eq_top (hn : 1 ≤ n) : frameAlg n = ⊤ := by
  refine eq_top_of_rankOne (wBasis n hn) (frameAlg n) ∅ Finset.univ ?_ ?_ ?_
  · rw [wBasis_apply, ← bigLower_eq n hn]
    exact lowerProd_mem n (n - 1) le_rfl
  · intro S
    refine ⟨ρW (sigma n S), ρW_sigma_mem n S, ?_⟩
    rw [wBasis_apply, wBasis_apply, ρW_sigma_w, ← Finset.bot_eq_empty, symmDiff_bot]
  · intro T
    refine ⟨ρW (sigma n (symmDiff T Finset.univ)), ρW_sigma_mem n _, ?_⟩
    refine (wBasis n hn).ext fun S ↦ ?_
    rw [LinearMap.comp_apply, wBasis_apply, ρW_sigma_w, ← wBasis_apply n hn,
      ← wBasis_apply n hn, Module.Basis.coord_apply, Module.Basis.coord_apply,
      Module.Basis.repr_self, Module.Basis.repr_self, Finsupp.single_apply,
      Finsupp.single_apply, if_congr (symmDiff_univ_symmDiff_eq_univ n S T) rfl rfl]

end Pairing.PerfectMatching
